{
    "name": "@classiq/api",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && pnpm run zip:lambda",
        "zip:lambda": "cd dist && zip -q -X -FS lambda.zip package.json index.mjs index.mjs.map",
        "dev": "pnpm run db:prepare && dotenv --override --no-expand -e .env.development -- vite --host 127.0.0.1",
        "test": "vitest run",
        "lint": "pnpm exec eslint --cache --cache-location .cache/eslint . --fix",
        "lint:check": "pnpm exec eslint --cache --cache-location .cache/eslint-check . --max-warnings=0",
        "prettier": "pnpm exec prettier --cache --cache-location .cache/prettier --ignore-path ../../.prettierignore . --write",
        "db:start": "docker compose up -d --wait",
        "db:prepare": "pnpm run db:start && pnpm run db:migrate",
        "db:stop": "docker compose down",
        "db:clean": "docker compose down --volumes",
        "db:migrate": "dotenv --override --no-expand -e .env.development -- tsx scripts/migrate.ts",
        "db:new": "tsx scripts/new-migration.ts",
        "check-types": "pnpm exec tsc --noEmit",
        "clean": "rm -rf dist .turbo .cache",
        "fullclean": "pnpm run clean && rm -rf node_modules",
        "db:migrate:prod": "dotenv --override --no-expand -e .env.production -- tsx scripts/migrate.ts"
    },
    "prettier": "@classiq/prettier",
    "dependencies": {
        "@ai-sdk/deepseek": "catalog:",
        "@ai-sdk/openai": "catalog:",
        "@aws-sdk/client-s3": "catalog:",
        "ai": "catalog:",
        "better-auth": "catalog:",
        "hono": "catalog:",
        "p-timeout": "catalog:",
        "pg": "catalog:",
        "zod": "catalog:",
        "@aws-sdk/s3-request-presigner": "catalog:",
        "unpdf": "catalog:"
    },
    "devDependencies": {
        "@classiq/eslint": "workspace:*",
        "@classiq/prettier": "workspace:*",
        "@classiq/typescript": "workspace:*",
        "@hono/vite-dev-server": "catalog:",
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "dotenv-cli": "catalog:",
        "eslint": "catalog:",
        "prettier": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
