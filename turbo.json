{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "globalEnv": [
        "DATABASE_URL",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "S3_ENDPOINT",
        "SQS_ENDPOINT",
        "SQS_QUEUE_URL",
        "COURSE_RESOURCE_FILES_BUCKET_NAME",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_ORIGINS",
        "AUTH_TEST_DATABASE_URL",
        "TEST_UPLOAD_DATABASE_URL",
        "PROCESSING_TEST_LOCAL",
        "NODE_ENV",
        "PROCESSING_MODE",
        "PROCESSING_FIXTURES",
        "FIXTURE_RECORDING_SECONDS",
        "LLM_PROVIDER",
        "DEEPSEEK_MODEL",
        "DEEPSEEK_API_KEY",
        "SONIOX_API_KEY",
        "SONIOX_MODEL",
        "SONIOX_KEY_FILE",
        "DEEPSEEK_KEY_FILE",
        "FFMPEG_PATH",
        "FFPROBE_PATH",
        "PROCESSING_LIVE_SMOKE",
        "PROCESSING_ENABLED",
        "PROCESSING_TEST_MEDIA_LAYER",
        "PROCESSING_LECTURE_MACHINE_ARN",
        "PROCESSING_RESOURCE_MACHINE_ARN"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "lint:check": {
            "dependsOn": ["^lint:check"]
        },
        "prettier": {
            "dependsOn": ["^prettier"]
        },
        "check-types": {
            "dependsOn": ["^build", "^check-types"]
        },
        "clean": {
            "dependsOn": ["^clean"],
            "cache": false
        },
        "fullclean": {
            "dependsOn": ["^fullclean"],
            "cache": false
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "synth": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["AWS_*", "CDK_*"]
        },
        "diff": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["AWS_*", "CDK_*"]
        },
        "deploy": {
            "dependsOn": ["^build"],
            "cache": false,
            "passThroughEnv": ["AWS_*", "CDK_*"]
        }
    }
}
